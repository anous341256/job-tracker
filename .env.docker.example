DB_ENGINE=mysql
DB_NAME=job_tracker
DB_TEST_NAME=test_job_tracker
DB_USER=job_tracker
DB_PASSWORD=job_tracker_dev_password
DB_HOST=mysql
DB_PORT=3306

SECRET_KEY=django-insecure-docker-dev-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,web
ACCOUNT_EMAIL_VERIFICATION=optional

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Job Tracker <noreply@localhost>

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Keep this empty until you enable cloud AI credentials in the UI.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_TASK_STALE_MINUTES=30

# Windows Host Agent. For a remote deployment, copy the value from
# D:\New project\.local\host-agent\token through a secure channel.
HOST_AGENT_ENABLED=True
HOST_AGENT_TOKEN=
HOST_AGENT_AUTO_SYNC_MINUTES=2
HOST_AGENT_MAX_BODY_BYTES=8388608
HOST_AGENT_ALLOW_INSECURE_LOCAL=True

# Enable only when Django is behind a trusted reverse proxy that overwrites
# X-Forwarded-Proto. The public site itself must use HTTPS.
TRUST_PROXY_HTTPS=False
